# Start from an empty build context and add back only the paths used by the
# smoke-test Dockerfile and Spectrum image builds.
*

!.ansible-lint
!.yamllint
!ansible.cfg
!pyproject.toml
!uv.lock

!containers/
!containers/**

!ansible/
!ansible/**
ansible/tests/

!bluebuild/
!bluebuild/**

# BlueBuild extracts embedded build helpers here before invoking BuildKit.
!.bluebuild-scripts_*/
!.bluebuild-scripts_*/**

!dotfiles/
!dotfiles/**

!npins/
!npins/sources.json

!packages/
packages/*
!packages/dotfiles-python/
packages/dotfiles-python/*
!packages/dotfiles-python/assets/
!packages/dotfiles-python/assets/**
!packages/dotfiles-python/src/
!packages/dotfiles-python/src/**
!packages/ghostty-patched/
!packages/ghostty-patched/**
!packages/hyper-window-tiling/
packages/hyper-window-tiling/*
!packages/hyper-window-tiling/package.json
!packages/hyper-window-tiling/bun.lock
!packages/hyper-window-tiling/tsconfig.json
!packages/hyper-window-tiling/src/
!packages/hyper-window-tiling/src/**
!packages/hyper-window-tiling/gnome/
!packages/hyper-window-tiling/gnome/**
!packages/hyper-window-tiling/kde/
!packages/hyper-window-tiling/kde/**
!packages/kanata/
!packages/kanata/kanata.kbd
!packages/kanata-with-cmd/
packages/kanata-with-cmd/*
!packages/kanata-with-cmd/build-linux.sh
!packages/kanata-with-cmd/patches/
!packages/kanata-with-cmd/patches/**
!packages/terminal-theme-tools/
packages/terminal-theme-tools/*
!packages/terminal-theme-tools/build.zig
!packages/terminal-theme-tools/build.zig.zon
!packages/terminal-theme-tools/build_support.zig
!packages/terminal-theme-tools/config/
!packages/terminal-theme-tools/config/**
!packages/terminal-theme-tools/include/
!packages/terminal-theme-tools/include/**
!packages/terminal-theme-tools/src/
!packages/terminal-theme-tools/src/**
!packages/terminal-theme-tools/tests/
!packages/terminal-theme-tools/tests/**
!packages/terminal-theme-tools/vendor/
!packages/terminal-theme-tools/vendor/**

# Never send local generated state if it appears under an included path.
**/.DS_Store
**/.rumdl_cache/
**/.zig-cache/
**/__pycache__/
**/*.pyc
**/node_modules/
**/target/
**/zig-out/
**/zig-pkg/
.docker-cache/
.git/
*.log
