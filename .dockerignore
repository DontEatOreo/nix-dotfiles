# Start from an empty build context and add back only the paths used by the
# smoke-test Dockerfile and Spectrum image builds.
*

!Dockerfile
!.dockerignore
!.ansible-lint
!.yamllint
!ansible.cfg
!pyproject.toml
!uv.lock

!containers/
!containers/**

!ansible/
!ansible/**

!bluebuild/
!bluebuild/**

# BlueBuild extracts embedded build helpers here before invoking BuildKit.
!.bluebuild-scripts_*/
!.bluebuild-scripts_*/**

!dotfiles/
!dotfiles/**

!npins/
!npins/sources.json

!packages/
packages/*
!packages/dotfiles-python/
!packages/dotfiles-python/**
!packages/ghostty-patched/
!packages/ghostty-patched/**
!packages/terminal-theme-tools/
!packages/terminal-theme-tools/**

# Never send local generated state if it appears under an included path.
**/.DS_Store
**/.rumdl_cache/
**/.zig-cache/
**/__pycache__/
**/*.pyc
**/node_modules/
**/target/
**/zig-out/
**/zig-pkg/
.docker-cache/
.git/
*.log
