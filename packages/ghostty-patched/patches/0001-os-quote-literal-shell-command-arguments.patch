From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 4evy <git@evy.pink>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 1/5] os: quote literal shell command arguments

Add POSIX-compatible literal argument quoting to ShellCommandBuilder and
reuse it when launching config editors. This preserves argument boundaries
for paths with whitespace or quotes and gives other shell command users a
shared implementation.

---
 src/os/edit.zig  |   21 ++++++---------------
 src/os/shell.zig |   51 +++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 57 insertions(+), 15 deletions(-)

--- a/src/os/edit.zig
+++ b/src/os/edit.zig
@@ -1,7 +1,7 @@
 const std = @import("std");
 
 const global = @import("../global.zig");
-const ShellEscapeWriter = @import("shell.zig").ShellEscapeWriter;
+const ShellCommandBuilder = @import("shell.zig").ShellCommandBuilder;
 
 const log = std.log.scoped(.os_edit);
 
@@ -52,18 +52,9 @@ pub fn getConfigEditCommand(alloc: std.m
     };
     defer alloc.free(editor);
 
-    var buffer: std.Io.Writer.Allocating = .init(alloc);
-    defer buffer.deinit();
-    const writer = &buffer.writer;
-
-    try writer.writeAll(editor);
-    try writer.writeByte(' ');
-    {
-        var sh: ShellEscapeWriter = .init(writer);
-        try sh.writer.writeAll(path);
-        try sh.writer.flush();
-    }
-    try writer.flush();
-
-    return try buffer.toOwnedSliceSentinel(0);
+    var command = ShellCommandBuilder.init(alloc);
+    defer command.deinit();
+    try command.appendArg(editor);
+    try command.appendQuotedArg(path);
+    return try command.toOwnedSlice();
 }
--- a/src/os/shell.zig
+++ b/src/os/shell.zig
@@ -25,6 +25,45 @@ pub const ShellCommandBuilder = struct {
         try self.buffer.writer.writeAll(arg);
     }
 
+    /// Append one literal argument using POSIX shell quoting. This mirrors
+    /// `Ghostty.Shell.quote` in the macOS runtime.
+    pub fn appendQuotedArg(self: *ShellCommandBuilder, arg: []const u8) (Allocator.Error || Writer.Error)!void {
+        if (self.buffer.written().len > 0) {
+            try self.buffer.writer.writeByte(' ');
+        }
+
+        if (arg.len == 0) return self.buffer.writer.writeAll("''");
+
+        const safe = for (arg) |byte| switch (byte) {
+            'a'...'z',
+            'A'...'Z',
+            '0'...'9',
+            '_',
+            '@',
+            '%',
+            '+',
+            '=',
+            ':',
+            ',',
+            '.',
+            '/',
+            '-',
+            => {},
+            else => break false,
+        } else true;
+        if (safe) return self.buffer.writer.writeAll(arg);
+
+        try self.buffer.writer.writeByte('\'');
+        for (arg) |byte| {
+            if (byte == '\'') {
+                try self.buffer.writer.writeAll("'\"'\"'");
+            } else {
+                try self.buffer.writer.writeByte(byte);
+            }
+        }
+        try self.buffer.writer.writeByte('\'');
+    }
+
     /// Get the final null-terminated command string, transferring ownership to caller.
     /// Calling deinit() after this is safe but unnecessary.
     pub fn toOwnedSlice(self: *ShellCommandBuilder) Allocator.Error![:0]const u8 {
@@ -77,6 +116,18 @@ test ShellCommandBuilder {
         try testing.expectEqualStrings("bash --posix", result);
         try testing.expectEqual(@as(u8, 0), result[result.len]);
     }
+
+    // Shell-quoted args
+    {
+        var cmd = ShellCommandBuilder.init(testing.allocator);
+        defer cmd.deinit();
+        try cmd.appendArg("hx");
+        try cmd.appendQuotedArg("/tmp/it's scrollback.txt");
+        try testing.expectEqualStrings(
+            "hx '/tmp/it'\"'\"'s scrollback.txt'",
+            cmd.buffer.written(),
+        );
+    }
 }
 
