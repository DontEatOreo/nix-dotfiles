From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 4evy <git@evy.pink>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 3/7] embedded: honor command wait-after-command setting

Propagate the surface option instead of forcing command surfaces to
remain open. Temporary editor surfaces need to close as soon as their
command exits.
---
 src/apprt/embedded.zig |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -551,7 +551,7 @@ pub const Surface = struct {
             const cmd = std.mem.sliceTo(c_command, 0);
             if (cmd.len > 0) {
                 config.command = .{ .shell = cmd };
-                config.@"wait-after-command" = true;
+                config.@"wait-after-command" = opts.wait_after_command;
             }
         }
 
