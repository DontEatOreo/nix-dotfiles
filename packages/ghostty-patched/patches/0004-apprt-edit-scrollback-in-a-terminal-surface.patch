+/// Open an exported scrollback file in a terminal-based editor.
+pub const EditScrollback = struct {
+    /// The directory containing the exported scrollback. The application
+    /// runtime owns its cleanup after accepting this action.
+    directory: []const u8,
+
+    /// A shell command containing the configured editor and the safely escaped
+    /// scrollback path. This is sentinel-terminated for surface creation APIs.
+    command: [:0]const u8,
+
+    // Sync with: ghostty_action_edit_scrollback_s
+    pub const C = extern struct {
+        directory: [*]const u8,
+        directory_len: usize,
+        command: [*:0]const u8,
+    };
+
+    pub fn cval(self: EditScrollback) C {
+        return .{
+            .directory = self.directory.ptr,
+            .directory_len = self.directory.len,
+            .command = self.command.ptr,
+        };
+    }
+};
 
