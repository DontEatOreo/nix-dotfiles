+/// Build the command used by the terminal scrollback editor. Shell commands
+/// retain their configured expansion behavior. Direct commands are quoted
+/// argument-by-argument because embedded runtimes accept a shell string.
+fn scrollbackEditorCommand(
+    alloc: Allocator,
+    editor: configpkg.Command,
+    path: []const u8,
+) ![:0]const u8 {
+    var command = internal_os.shell.ShellCommandBuilder.init(alloc);
+    defer command.deinit();
+    switch (editor) {
+        .shell => |value| try command.appendArg(value),
+        .direct => |argv| for (argv) |arg| try command.appendQuotedArg(arg),
+    }
+    try command.appendQuotedArg(path);
+    return try command.toOwnedSlice();
+}
