+    pub fn editScrollback(
+        self: *Application,
+        target: apprt.Target,
+        value: apprt.action.EditScrollback,
+    ) bool {
+        const core = switch (target) {
+            .app => return false,
+            .surface => |surface| surface,
+        };
+        const original = core.rt_surface.surface;
+        const split_tree = ext.getAncestor(
+            SplitTree,
+            original.as(gtk.Widget),
+        ) orelse return false;
+
+        // Only replace a surface that still occupies its pane. This also
+        // avoids racing a second transient replacement.
+        if (split_tree.getActiveSurface() != original) return false;
+
+        const editor: *Surface = .new(.{
+            .command = .{ .shell = value.command },
+            .wait_after_command = false,
+            .title = std.mem.span(i18n._("Scrollback")),
+        });
+        _ = editor.refSink();
+        editor.setParent(core, .split);
+        editor.bindIsSplit(split_tree);
+
+        const alloc = self.allocator();
+        const temp_dir = alloc.dupe(u8, value.directory) catch {
+            editor.unref();
+            return false;
+        };
+        const state = alloc.create(EditScrollbackState) catch {
+            alloc.free(temp_dir);
+            editor.unref();
+            return false;
+        };
+        state.* = .{
+            .app = self,
+            .original = original.ref(),
+            .temp_dir = temp_dir,
+        };
+        state.split_tree.set(split_tree);
+
+        state.close_handler = Surface.signals.@"close-request".connect(
+            editor,
+            *EditScrollbackState,
+            editScrollbackClose,
+            state,
+            .{},
+        );
+        editor.as(gobject.Object).weakRef(editScrollbackWeakNotify, state);
+
+        if (!(split_tree.replaceSurface(original, editor) catch false)) {
+            editor.as(gobject.Object).weakUnref(editScrollbackWeakNotify, state);
+            gobject.signalHandlerDisconnect(
+                editor.as(gobject.Object),
+                state.close_handler,
+            );
+            state.split_tree.deinit();
+            state.original.unref();
+            alloc.free(state.temp_dir);
+            alloc.destroy(state);
+            editor.unref();
+            return false;
+        }
+
+        // The split tree now owns the editor. The state deliberately keeps
+        // only a weak association so closing the containing window cannot
+        // form a reference cycle.
+        editor.unref();
+        editor.grabFocus();
+        return true;
+    }
+
+    const EditScrollbackState = struct {
+        app: *Application,
+        split_tree: WeakRef(SplitTree) = .empty,
+        original: *Surface,
+        temp_dir: []u8,
+        close_handler: c_ulong = 0,
+        restoring: bool = false,
+    };
+
+    fn editScrollbackClose(
+        editor: *Surface,
+        state: *EditScrollbackState,
+    ) callconv(.c) void {
+        if (state.restoring) return;
+        state.restoring = true;
+
+        editor.as(gobject.Object).weakUnref(editScrollbackWeakNotify, state);
+        gobject.signalHandlerDisconnect(
+            editor.as(gobject.Object),
+            state.close_handler,
+        );
+        state.close_handler = 0;
+
+        if (state.split_tree.get()) |split_tree| {
+            defer split_tree.unref();
+            if (split_tree.replaceSurface(editor, state.original) catch false) {
+                state.original.grabFocus();
+            }
+        }
+
+        // Release the original surface and delete the export only after the
+        // close signal has finished emitting.
+        _ = glib.idleAdd(editScrollbackCleanup, state);
+    }
+
+    fn editScrollbackWeakNotify(
+        ud: ?*anyopaque,
+        _: *gobject.Object,
+    ) callconv(.c) void {
+        const state: *EditScrollbackState = @ptrCast(@alignCast(
+            ud orelse return,
+        ));
+        destroyEditScrollbackState(state);
+    }
+
+    fn editScrollbackCleanup(ud: ?*anyopaque) callconv(.c) c_int {
+        const state: *EditScrollbackState = @ptrCast(@alignCast(
+            ud orelse return 0,
+        ));
+        destroyEditScrollbackState(state);
+        return 0;
+    }
+
+    fn destroyEditScrollbackState(state: *EditScrollbackState) void {
+        state.split_tree.deinit();
+        state.original.unref();
+
+        const app = state.app;
+        std.Io.Dir.cwd().deleteTree(global.io(), state.temp_dir) catch |err|
+            log.warn("failed to delete scrollback directory path={s} err={}", .{
+                state.temp_dir,
+                err,
+            });
+        app.allocator().free(state.temp_dir);
+        app.allocator().destroy(state);
+    }
