+        final class ScrollbackEditorSession {
+            let original: Ghostty.SurfaceView
+            let directory: URL
+
+            init(
+                original: Ghostty.SurfaceView,
+                directory: URL
+            ) {
+                self.original = original
+                self.directory = directory
+            }
+
+            deinit {
+                do {
+                    try FileManager.default.removeItem(at: directory)
+                } catch {
+                    let cocoaError = error as NSError
+                    if cocoaError.code != NSFileNoSuchFileError {
+                        Ghostty.logger.warning(
+                            "failed to delete scrollback directory: \(error, privacy: .public)"
+                        )
+                    }
+                }
+            }
+        }
+
+        private static func editScrollback(
+            _ app: ghostty_app_t,
+            target: ghostty_target_s,
+            value: ghostty_action_edit_scrollback_s
+        ) -> Bool {
+            guard target.tag == GHOSTTY_TARGET_SURFACE,
+                  let coreSurface = target.target.surface,
+                  let original = surfaceView(from: coreSurface),
+                  let controller = BaseTerminalController.controller(owning: original),
+                  let node = controller.surfaceTree.root?.node(view: original),
+                  let directoryPointer = value.directory,
+                  let commandPointer = value.command
+            else { return false }
+
+            let directoryData = Data(bytes: directoryPointer, count: Int(value.directory_len))
+            guard let directory = String(data: directoryData, encoding: .utf8) else { return false }
+
+            var config = SurfaceConfiguration(
+                from: ghostty_surface_inherited_config(coreSurface, GHOSTTY_SURFACE_CONTEXT_SPLIT)
+            )
+            config.command = String(cString: commandPointer)
+            config.waitAfterCommand = false
+            config.context = GHOSTTY_SURFACE_CONTEXT_SPLIT
+
+            let editor = SurfaceView(app, baseConfig: config)
+            guard editor.surface != nil else { return false }
+
+            do {
+                let replacement = try controller.surfaceTree.replacing(
+                    node: node,
+                    with: .leaf(view: editor)
+                )
+                editor.scrollbackEditorSession = .init(
+                    original: original,
+                    directory: URL(filePath: directory)
+                )
+                controller.replaceSurfaceTree(
+                    replacement,
+                    moveFocusTo: editor,
+                    moveFocusFrom: original,
+                    undoable: false
+                )
+                return true
+            } catch {
+                logger.warning("failed to open scrollback editor surface: \(error, privacy: .public)")
+                return false
+            }
+        }
