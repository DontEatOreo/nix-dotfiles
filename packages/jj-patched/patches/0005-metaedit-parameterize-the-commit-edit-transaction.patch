From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 4evy <git@evy.pink>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 5/10] metaedit: parameterize the commit edit transaction

Add explicit transaction policy for status text, target signing, and
descendant metadata preservation. Keep metaedit's default behavior
unchanged while allowing sibling commands to reuse the same rewrite path
with different policies.
---
 cli/src/commands/metaedit.rs |   68 ++++++++++++++++++++++++++++++++++++-------
 1 file changed, 58 insertions(+), 10 deletions(-)

--- a/cli/src/commands/metaedit.rs
+++ b/cli/src/commands/metaedit.rs
@@ -18,7 +18,10 @@ use clap_complete::ArgValueCompleter;
 use futures::TryStreamExt as _;
 use jj_lib::backend::Timestamp;
 use jj_lib::commit::Commit;
+use jj_lib::commit_builder::CommitBuilder;
 use jj_lib::object_id::ObjectId as _;
+use jj_lib::rewrite::CommitRewriter;
+use jj_lib::signing::SignBehavior;
 use jj_lib::time_util::parse_datetime;
 use tracing::instrument;
 
@@ -166,6 +169,23 @@ pub(crate) struct CommitEditArgs {
     force_rewrite: bool,
 }
 
+#[derive(Clone, Copy)]
+pub(crate) struct CommitEditOptions {
+    transaction_action: &'static str,
+    force_sign: bool,
+    preserve_descendant_metadata: bool,
+}
+
+impl Default for CommitEditOptions {
+    fn default() -> Self {
+        Self {
+            transaction_action: "edit commit metadata for",
+            force_sign: false,
+            preserve_descendant_metadata: false,
+        }
+    }
+}
+
 #[instrument(skip_all)]
 pub(crate) async fn cmd_metaedit(
     ui: &mut Ui,
@@ -194,26 +214,33 @@ pub(crate) async fn cmd_metaedit(
         return Ok(());
     }
 
-    edit_commits(ui, &mut workspace_command, &args.edit_args, commit_ids).await
+    edit_commits(
+        ui,
+        &mut workspace_command,
+        &args.edit_args,
+        CommitEditOptions::default(),
+        commit_ids,
+    )
+    .await
 }
 
 pub(crate) async fn edit_commits(
     ui: &mut Ui,
     workspace_command: &mut WorkspaceCommandHelper,
     args: &CommitEditArgs,
+    options: CommitEditOptions,
     commit_ids: Vec<jj_lib::backend::CommitId>,
 ) -> Result<(), CommandError> {
     let mut tx = workspace_command.start_transaction();
     let tx_description = match commit_ids.as_slice() {
         [] => unreachable!(),
-        [commit] => format!("edit commit metadata for commit {}", commit.hex()),
-        [first_commit, remaining_commits @ ..] => {
-            format!(
-                "edit commit metadata for commit {} and {} more",
-                first_commit.hex(),
-                remaining_commits.len()
-            )
-        }
+        [commit] => format!("{} commit {}", options.transaction_action, commit.hex()),
+        [first_commit, remaining_commits @ ..] => format!(
+            "{} commit {} and {} more",
+            options.transaction_action,
+            first_commit.hex(),
+            remaining_commits.len()
+        ),
     };
 
     let new_description = args
@@ -237,6 +264,7 @@ pub(crate) async fn edit_commits(
 
                 let old_author = rewriter.old_commit().author().clone();
                 let old_committer = rewriter.old_commit().committer().clone();
+                let was_signed = rewriter.old_commit().is_signed();
                 let mut commit_builder = rewriter.reparent();
                 let mut new_author = commit_builder.author().clone();
                 if let Some((name, email)) = args.author.clone() {
@@ -298,12 +326,21 @@ pub(crate) async fn edit_commits(
                     rewrite = true;
                 }
 
+                if options.force_sign {
+                    commit_builder = commit_builder.set_sign_behavior(SignBehavior::Force);
+                    rewrite |= !was_signed;
+                }
+
                 if rewrite {
                     let new_commit = commit_builder.write().await?;
                     modified.push(new_commit);
                 }
             } else if rewriter.parents_changed() {
-                rewriter.reparent().write().await?;
+                if options.preserve_descendant_metadata {
+                    reparent_preserving_metadata(rewriter).write().await?;
+                } else {
+                    rewriter.reparent().write().await?;
+                }
                 num_reparented += 1;
             }
             Ok(())
@@ -321,3 +358,14 @@ pub(crate) async fn edit_commits(
     tx.finish(ui, tx_description).await?;
     Ok(())
 }
+
+fn reparent_preserving_metadata(rewriter: CommitRewriter<'_>) -> CommitBuilder<'_> {
+    let old_commit = rewriter.old_commit();
+    let author = old_commit.author().clone();
+    let committer = old_commit.committer().clone();
+    rewriter
+        .reparent()
+        .set_author(author)
+        .set_committer(committer)
+        .set_sign_behavior(SignBehavior::Keep)
+}
