From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 4evy <git@evy.pink>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH 2/9] git push: warn about immutable signing candidates

Evaluate the configured sign-on-push revset across every outgoing
commit, then exclude immutable matches from rewriting and list them in a
warning. This follows the same immutability boundary as other
history-editing commands while making skipped signatures visible.
---
 CHANGELOG.md                 |    3 +++
 cli/src/commands/git/push.rs |   39 ++++++++++++++++++++++++++++++++++++---
 cli/tests/test_git_push.rs   |    2 ++
 3 files changed, 41 insertions(+), 3 deletions(-)

--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -50,6 +50,9 @@ to [Semantic Versioning](https://semver.
 
 ### Fixed bugs
 
+* `jj git push` now warns when `git.sign-on-push` selects immutable commits
+  instead of silently leaving them unsigned.
+
 * The default pager flags now include `-K` (`--quit-on-intr`), so pressing
   Ctrl+C in `less` exits cleanly instead of leaving the terminal in a
   corrupted state (raw mode, visible escape sequences, broken input).
--- a/cli/src/commands/git/push.rs
+++ b/cli/src/commands/git/push.rs
@@ -65,6 +65,7 @@ use crate::cli_util::WorkspaceCommandHel
 use crate::cli_util::WorkspaceCommandTransaction;
 use crate::cli_util::has_tracked_remote_bookmarks;
 use crate::cli_util::has_tracked_remote_tags;
+use crate::cli_util::print_updated_commits;
 use crate::cli_util::short_change_hash;
 use crate::cli_util::short_commit_hash;
 use crate::command_error::CommandError;
@@ -799,13 +800,14 @@ fn ready_to_push_revset_expression(
         .flat_map(|(_, old_head)| old_head.target.added_ids())
         .cloned()
         .collect_vec();
-    RevsetExpression::commits(old_heads)
-        .union(workspace_helper.env().immutable_heads_expression())
-        .range(&RevsetExpression::commits(new_heads))
+    RevsetExpression::commits(old_heads).range(&RevsetExpression::commits(new_heads))
 }
 
 /// Signs commits before pushing.
 ///
+/// Warns about selected commits that are immutable and therefore cannot be
+/// rewritten.
+///
 /// Returns the updated list of bookmark names and corresponding
 /// [`BookmarkPushUpdate`]s.
 async fn sign_commits_before_push(
@@ -814,7 +816,38 @@ async fn sign_commits_before_push(
     commits_to_sign: Arc<ResolvedRevsetExpression>,
     ref_updates: GitPushRefTargets,
 ) -> Result<GitPushRefTargets, CommandError> {
+    let workspace_helper = tx.base_workspace_helper();
+    let immutable = workspace_helper
+        .attach_revset_evaluator(workspace_helper.env().immutable_expression())
+        .resolve()?;
+    let skipped: Vec<Commit> = commits_to_sign
+        .intersection(&immutable)
+        .evaluate(tx.base_repo().as_ref())?
+        .stream()
+        .commits(tx.base_repo().store())
+        .take(11)
+        .try_collect()
+        .await?;
+    if !skipped.is_empty() {
+        let count = if skipped.len() > 10 {
+            "10+".to_owned()
+        } else {
+            skipped.len().to_string()
+        };
+        writeln!(
+            ui.warning_default(),
+            "Skipped signing {count} immutable commits:"
+        )?;
+        let mut formatter = ui.stderr_formatter();
+        print_updated_commits(
+            formatter.as_mut(),
+            &workspace_helper.commit_summary_template(),
+            &skipped,
+        )?;
+    }
+
     let commit_ids: IndexSet<CommitId> = commits_to_sign
+        .minus(&immutable)
         .evaluate(tx.base_repo().as_ref())?
         .stream()
         .commits(tx.base_repo().store())
--- a/cli/tests/test_git_push.rs
+++ b/cli/tests/test_git_push.rs
@@ -3079,6 +3079,8 @@ fn test_git_push_sign_on_push() {
     let output = work_dir.run_jj(["git", "push"]);
     insta::assert_snapshot!(output, @"
     ------- stderr -------
+    Warning: Skipped signing 1 immutable commits:
+      kpqxywon 48ea83e9 bookmark2* | (empty) commit which should not be signed 1
     Changes to push to origin:
       bookmark: bookmark2 [move forward from d45e2adce0ad to 48ea83e9499c]
     [EOF]
