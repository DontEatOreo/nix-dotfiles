+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_line_editor_navigation_and_editing() {
+        let mut editor = LineEditor::new("abcd");
+        assert_eq!(editor.cursor, 4);
+
+        editor.handle_key(KeyCode::Left, KeyModifiers::NONE);
+        editor.handle_key(KeyCode::Left, KeyModifiers::NONE);
+        editor.handle_key(KeyCode::Backspace, KeyModifiers::NONE);
+        assert_eq!(editor.value, "acd");
+        assert_eq!(editor.cursor, 1);
+
+        editor.handle_key(KeyCode::Char('X'), KeyModifiers::SHIFT);
+        editor.handle_key(KeyCode::Delete, KeyModifiers::NONE);
+        assert_eq!(editor.value, "aXd");
+        assert_eq!(editor.cursor, 2);
+
+        editor.handle_key(KeyCode::Home, KeyModifiers::NONE);
+        editor.handle_key(KeyCode::Char('!'), KeyModifiers::NONE);
+        editor.handle_key(KeyCode::End, KeyModifiers::NONE);
+        assert_eq!(editor.value, "!aXd");
+        assert_eq!(editor.cursor, editor.value.len());
+    }
+
+    #[test]
+    fn test_line_editor_unicode_boundaries_and_actions() {
+        let mut editor = LineEditor::new("aé");
+        editor.handle_key(KeyCode::Left, KeyModifiers::NONE);
+        assert_eq!(editor.cursor, 1);
+        editor.handle_key(KeyCode::Delete, KeyModifiers::NONE);
+        assert_eq!(editor.value, "a");
+
+        assert_eq!(
+            editor.handle_key(KeyCode::Enter, KeyModifiers::NONE),
+            LineEditorAction::Submit
+        );
+        assert_eq!(
+            editor.handle_key(KeyCode::Esc, KeyModifiers::NONE),
+            LineEditorAction::Cancel
+        );
+    }
+}
