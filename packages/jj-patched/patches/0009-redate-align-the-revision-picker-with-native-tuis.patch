+/// Reads a line of text with `initial` prefilled as editable input.
+///
+/// Returns `None` if the user presses Escape or Ctrl-C.
+pub(crate) fn edit_line(prompt: &str, initial: &str) -> io::Result<Option<String>> {
+    if !io::stdin().is_terminal() || !io::stderr().is_terminal() {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "Cannot edit a prefilled prompt without a terminal",
+        ));
+    }
+
+    enable_raw_mode()?;
+    let _terminal_guard = CleanupGuard::new(|| drop(disable_raw_mode()));
+    let mut output = io::stderr();
+    let mut editor = LineEditor::new(initial);
+    editor.draw(&mut output, prompt)?;
+
+    loop {
+        let Event::Key(key) = event::read()? else {
+            continue;
+        };
+        if key.is_release() {
+            continue;
+        }
+        match editor.handle_key(key.code, key.modifiers) {
+            LineEditorAction::Continue => editor.draw(&mut output, prompt)?,
+            LineEditorAction::Submit => {
+                write!(output, "\r\n")?;
+                output.flush()?;
+                return Ok(Some(editor.value));
+            }
+            LineEditorAction::Cancel => {
+                write!(output, "\r\n")?;
+                output.flush()?;
+                return Ok(None);
+            }
+        }
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum LineEditorAction {
+    Continue,
+    Submit,
+    Cancel,
+}
+
+struct LineEditor {
+    value: String,
+    cursor: usize,
+}
+
+impl LineEditor {
+    fn new(initial: &str) -> Self {
+        Self {
+            value: initial.to_owned(),
+            cursor: initial.len(),
+        }
+    }
+
+    fn draw(&self, output: &mut impl Write, prompt: &str) -> io::Result<()> {
+        output
+            .queue(MoveToColumn(0))?
+            .queue(Clear(ClearType::CurrentLine))?;
+        write!(output, "{prompt}: {}", self.value)?;
+        let cursor_column = prompt.width() + 2 + self.value[..self.cursor].width();
+        output.queue(MoveToColumn(cursor_column.min(usize::from(u16::MAX)) as u16))?;
+        output.flush()
+    }
+
+    fn handle_key(&mut self, code: KeyCode, modifiers: KeyModifiers) -> LineEditorAction {
+        match (code, modifiers) {
+            (KeyCode::Enter, KeyModifiers::NONE) => LineEditorAction::Submit,
+            (KeyCode::Esc, KeyModifiers::NONE) | (KeyCode::Char('c'), KeyModifiers::CONTROL) => {
+                LineEditorAction::Cancel
+            }
+            (KeyCode::Left, KeyModifiers::NONE) | (KeyCode::Char('b'), KeyModifiers::CONTROL) => {
+                self.cursor = self.previous_char_boundary();
+                LineEditorAction::Continue
+            }
+            (KeyCode::Right, KeyModifiers::NONE) | (KeyCode::Char('f'), KeyModifiers::CONTROL) => {
+                self.cursor = self.next_char_boundary();
+                LineEditorAction::Continue
+            }
+            (KeyCode::Home, KeyModifiers::NONE) | (KeyCode::Char('a'), KeyModifiers::CONTROL) => {
+                self.cursor = 0;
+                LineEditorAction::Continue
+            }
+            (KeyCode::End, KeyModifiers::NONE) | (KeyCode::Char('e'), KeyModifiers::CONTROL) => {
+                self.cursor = self.value.len();
+                LineEditorAction::Continue
+            }
+            (KeyCode::Backspace, KeyModifiers::NONE) => {
+                let previous = self.previous_char_boundary();
+                self.value.replace_range(previous..self.cursor, "");
+                self.cursor = previous;
+                LineEditorAction::Continue
+            }
+            (KeyCode::Delete, KeyModifiers::NONE) => {
+                self.value
+                    .replace_range(self.cursor..self.next_char_boundary(), "");
+                LineEditorAction::Continue
+            }
+            (KeyCode::Char(character), KeyModifiers::NONE | KeyModifiers::SHIFT) => {
+                self.value.insert(self.cursor, character);
+                self.cursor += character.len_utf8();
+                LineEditorAction::Continue
+            }
+            _ => LineEditorAction::Continue,
+        }
+    }
+
+    fn previous_char_boundary(&self) -> usize {
+        self.value[..self.cursor]
+            .char_indices()
+            .next_back()
+            .map_or(0, |(index, _)| index)
+    }
+
+    fn next_char_boundary(&self) -> usize {
+        self.value[self.cursor..]
+            .chars()
+            .next()
+            .map_or(self.cursor, |character| self.cursor + character.len_utf8())
+    }
+}
