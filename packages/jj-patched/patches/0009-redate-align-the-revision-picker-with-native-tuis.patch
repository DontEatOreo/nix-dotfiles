 impl SelectorState {
+    fn move_cursor(&mut self, cursor: usize) {
+        self.cursor = cursor;
+        self.range = None;
+    }
+
+    fn extend_range(&mut self, cursor: usize) {
+        if cursor == self.cursor {
+            return;
+        }
+        if self.range.is_none() {
+            self.range = Some(SelectionRange {
+                anchor: self.cursor,
+                selection_before_range: self.selected.clone(),
+            });
+        }
+        let range = self.range.as_ref().unwrap();
+        self.cursor = cursor;
+        self.selected.clone_from(&range.selection_before_range);
+        let (start, end) = if range.anchor <= cursor {
+            (range.anchor, cursor)
+        } else {
+            (cursor, range.anchor)
+        };
+        self.selected.extend(start..=end);
+        self.invalid = false;
+    }
