+fn render_rows(
+    ui: &Ui,
+    workspace_command: &WorkspaceCommandHelper,
+    commits: &[Commit],
+) -> Result<Vec<Text<'static>>, CommandError> {
+    let template = workspace_command
+        .parse_commit_template(
+            ui,
+            &workspace_command
+                .settings()
+                .get_string("templates.redate")?,
+        )?
+        .labeled(["commit"]);
+    commits
+        .iter()
+        .map(|commit| {
+            let mut output = vec![];
+            let mut formatter = ui.new_formatter(&mut output).into_labeled("redate");
+            template
+                .format(commit, formatter.as_mut())
+                .map_err(|error| internal_error(format!("Failed to format redate row: {error}")))?;
+            drop(formatter);
+            output
+                .into_text()
+                .map_err(|error| internal_error(format!("Failed to render redate row: {error}")))
+        })
+        .collect()
+}
+
+fn select_revisions(rows: Vec<Text<'static>>) -> Result<Option<Vec<usize>>, CommandError> {
+    io::stdout().execute(EnterAlternateScreen)?;
+    let _terminal_guard = CleanupGuard::new(|| {
+        drop(disable_raw_mode());
+        drop(io::stdout().execute(LeaveAlternateScreen));
+    });
+    enable_raw_mode()?;
+    let mut terminal = Terminal::new(CrosstermBackend::new(io::stdout()))?;
+    terminal.clear()?;
+    run_selector(&mut terminal, &rows)
+}
+
+fn run_selector<B: ratatui::backend::Backend>(
+    terminal: &mut Terminal<B>,
+    rows: &[Text<'static>],
+) -> Result<Option<Vec<usize>>, CommandError> {
+    let mut list_state = ListState::default().with_selected(Some(0));
+    let mut selected = HashSet::new();
+    let mut invalid = false;
+
+    loop {
+        terminal
+            .draw(|frame| {
+                let areas = Layout::vertical([Constraint::Fill(1), Constraint::Length(1)])
+                    .split(frame.area());
+                let items = rows.iter().enumerate().map(|(index, row)| {
+                    let mut row = row.clone();
+                    let marker = if selected.contains(&index) {
+                        Span::styled(
+                            "● ",
+                            Style::default()
+                                .fg(Color::Magenta)
+                                .add_modifier(Modifier::BOLD),
+                        )
+                    } else {
+                        Span::styled("○ ", Style::default().fg(Color::DarkGray))
+                    };
+                    if let Some(line) = row.lines.first_mut() {
+                        line.spans.insert(0, marker);
+                    } else {
+                        row.lines.push(Line::from(marker));
+                    }
+                    ListItem::new(row)
+                });
+                let list = List::new(items)
+                    .block(
+                        Block::bordered()
+                            .title(format!(" Select revisions ({} selected) ", selected.len())),
+                    )
+                    .highlight_symbol(
+                        Line::from("› ").style(
+                            Style::default()
+                                .fg(Color::Magenta)
+                                .add_modifier(Modifier::BOLD),
+                        ),
+                    )
+                    .scroll_padding(1);
+                frame.render_stateful_widget(list, areas[0], &mut list_state);
+
+                let footer = if invalid {
+                    Line::from("Select at least one revision")
+                        .style(Style::default().fg(Color::Red))
+                } else {
+                    Line::from("↑↓/jk move · space toggle · enter confirm · q cancel")
+                        .style(Style::default().fg(Color::DarkGray))
+                };
+                frame.render_widget(Paragraph::new(footer), areas[1]);
+            })
+            .map_err(|error| internal_error(format!("Failed to draw redate TUI: {error}")))?;
+
+        let Event::Key(key) = event::read()
+            .map_err(|error| internal_error(format!("Failed to read redate TUI input: {error}")))?
+        else {
+            continue;
+        };
+        if key.is_release() {
+            continue;
+        }
+        let current = list_state.selected().unwrap_or(0).min(rows.len() - 1);
+        match (key.code, key.modifiers) {
+            (KeyCode::Char('q') | KeyCode::Esc, KeyModifiers::NONE)
+            | (KeyCode::Char('c'), KeyModifiers::CONTROL) => return Ok(None),
+            (KeyCode::Enter, KeyModifiers::NONE) if !selected.is_empty() => {
+                return Ok(Some(
+                    (0..rows.len())
+                        .filter(|index| selected.contains(index))
+                        .collect(),
+                ));
+            }
+            (KeyCode::Enter, KeyModifiers::NONE) => invalid = true,
+            (KeyCode::Down | KeyCode::Char('j'), KeyModifiers::NONE) => {
+                list_state.select(Some((current + 1).min(rows.len() - 1)));
+            }
+            (KeyCode::Up | KeyCode::Char('k'), KeyModifiers::NONE) => {
+                list_state.select(Some(current.saturating_sub(1)));
+            }
+            (KeyCode::Char(' '), KeyModifiers::NONE) => {
+                if !selected.insert(current) {
+                    selected.remove(&current);
+                }
+                invalid = false;
+            }
+            _ => {}
+        }
+    }
+}
