+use std::process::Command;
+
+use indoc::formatdoc;
+
+use crate::common::TestEnvironment;
+use crate::common::TestWorkDir;
+use crate::common::to_toml_value;
+
+#[test]
+fn test_redate_is_exact_and_reuses_historical_signed_commit() {
+    let test_env = TestEnvironment::default();
+    configure_ssh_signing(&test_env);
+    test_env.run_jj_in(".", ["git", "init", "repo"]).success();
+    let work_dir = test_env.work_dir("repo");
+
+    work_dir.run_jj(["describe", "-m", "target"]).success();
+    work_dir.run_jj(["new", "-m", "signed child"]).success();
+    work_dir.run_jj(["sign", "-r", "@"]).success();
+    work_dir.run_jj(["new", "-m", "unsigned child"]).success();
+
+    let expected_descendant_metadata = descendant_metadata(&work_dir);
+
+    redate(&work_dir, "@--", "2002-03-04", "05:06:07");
+    let first_commit_id = commit_id(&work_dir, "@--");
+    assert_eq!(
+        commit_metadata(&work_dir, "@--"),
+        "2002-03-04 05:06:07|2002-03-04 05:06:07|good\n"
+    );
+    assert_eq!(descendant_metadata(&work_dir), expected_descendant_metadata);
+
+    let operation_id = work_dir.current_operation_id();
+    redate(&work_dir, "@--", "2002-03-04", "05:06:07");
+    assert_eq!(commit_id(&work_dir, "@--"), first_commit_id);
+    assert_eq!(work_dir.current_operation_id(), operation_id);
+    assert_eq!(descendant_metadata(&work_dir), expected_descendant_metadata);
+
+    redate(&work_dir, "@--", "2003-04-05", "06:07:08");
+    assert_ne!(commit_id(&work_dir, "@--"), first_commit_id);
+    assert_eq!(
+        commit_metadata(&work_dir, "@--"),
+        "2003-04-05 06:07:08|2003-04-05 06:07:08|good\n"
+    );
+    assert_eq!(descendant_metadata(&work_dir), expected_descendant_metadata);
+
+    redate(&work_dir, "@--", "2002-03-04", "05:06:07");
+    assert_eq!(commit_id(&work_dir, "@--"), first_commit_id);
+    assert_eq!(
+        commit_metadata(&work_dir, "@--"),
+        "2002-03-04 05:06:07|2002-03-04 05:06:07|good\n"
+    );
+    assert_eq!(descendant_metadata(&work_dir), expected_descendant_metadata);
+
+    work_dir.run_jj(["evolog", "-r", "@--"]).success();
+}
+
+fn configure_ssh_signing(test_env: &TestEnvironment) {
+    let key_path = test_env.env_root().join("signing-key");
+    let output = Command::new("ssh-keygen")
+        .args(["-q", "-t", "ed25519", "-N", "", "-f"])
+        .arg(&key_path)
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "{output:?}");
+    let public_key = std::fs::read_to_string(key_path.with_extension("pub")).unwrap();
+    let allowed_signers_path = test_env.env_root().join("allowed-signers");
+    std::fs::write(
+        &allowed_signers_path,
+        format!("test.user@example.com {public_key}"),
+    )
+    .unwrap();
+    test_env.add_config(formatdoc! {r#"
+        [signing]
+        backend = "ssh"
+        behavior = "keep"
+        key = {key}
+
+        [signing.backends.ssh]
+        allowed-signers = {allowed_signers}
+    "#,
+        key = to_toml_value(key_path.to_string_lossy().into_owned()),
+        allowed_signers =
+            to_toml_value(allowed_signers_path.to_string_lossy().into_owned()),
+    });
+}
+
+fn redate(work_dir: &TestWorkDir, revision: &str, date: &str, time: &str) {
+    work_dir
+        .run_jj_with(|cmd| {
+            cmd.env("JJ_INTERACTIVE", "1")
+                .env("TZ", "UTC")
+                .args(["redate", "-r", revision])
+                .write_stdin(format!("{date}\n{time}\ny\n"))
+        })
+        .success();
+}
+
+fn commit_id(work_dir: &TestWorkDir, revision: &str) -> String {
+    work_dir
+        .run_jj(["log", "--no-graph", "-r", revision, "-T", "commit_id"])
+        .success()
+        .stdout
+        .raw()
+        .to_owned()
+}
+
+fn commit_metadata(work_dir: &TestWorkDir, revision: &str) -> String {
+    work_dir
+        .run_jj([
+            "log",
+            "--no-graph",
+            "-r",
+            revision,
+            "-T",
+            r#"author.timestamp().utc().format("%Y-%m-%d %H:%M:%S")
+              ++ "|" ++ committer.timestamp().utc().format("%Y-%m-%d %H:%M:%S")
+              ++ "|" ++ signature.status() ++ "\n""#,
+        ])
+        .success()
+        .stdout
+        .raw()
+        .to_owned()
+}
+
+fn descendant_metadata(work_dir: &TestWorkDir) -> String {
+    work_dir
+        .run_jj([
+            "log",
+            "--no-graph",
+            "-r",
+            "@|@-",
+            "-T",
+            r#"change_id ++ "|" ++ author ++ "|" ++ committer
+              ++ "|" ++ if(signature, signature.status(), "unsigned") ++ "\n""#,
+        ])
+        .success()
+        .stdout
+        .raw()
+        .to_owned()
+}
