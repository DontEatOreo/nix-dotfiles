+fn prompt_timestamp(ui: &Ui) -> Result<Timestamp, CommandError> {
+    let now = Local::now();
+    let default_date = now.format("%Y-%m-%d").to_string();
+    let date = prompt_prefilled(ui, "Date (YYYY-MM-DD)", &default_date, |input| {
+        NaiveDate::parse_from_str(input, "%Y-%m-%d")
+    })?;
+    let default_time = now.format("%H:%M:%S").to_string();
+    let time = prompt_prefilled(ui, "Time (HH[:MM[:SS]])", &default_time, parse_time)?;
+    let local = Local
+        .from_local_datetime(&date.and_time(time))
+        .earliest()
+        .ok_or_else(|| user_error("The selected local time does not exist"))?;
+    Ok(Timestamp::from_datetime(local.fixed_offset()))
+}
+
+fn prompt_prefilled<T, E: std::fmt::Debug + std::fmt::Display>(
+    ui: &Ui,
+    prompt: &str,
+    initial: &str,
+    mut parse: impl FnMut(&str) -> Result<T, E>,
+) -> Result<T, CommandError> {
+    if !io::stdin().is_terminal() {
+        return Ok(ui.prompt_choice_with(prompt, Some(initial), parse)?);
+    }
+    let mut terminal = line_editor_terminal().map_err(internal_error)?;
+    let mut editor = LineEditor::new(&mut terminal);
+    editor.set_prompt(&format!("{prompt}: "));
+    let mut host = NopLineEditorHost::default();
+    let mut input = initial.to_owned();
+    loop {
+        input = editor
+            .read_line_with_optional_initial_value(&mut host, Some(&input))
+            .map_err(internal_error)?
+            .ok_or_else(|| user_error("Prompt canceled"))?;
+        match parse(input.trim()) {
+            Ok(value) => return Ok(value),
+            Err(error) => writeln!(ui.warning_no_heading(), "{error}")?,
+        }
+    }
+}
+
+fn parse_time(input: &str) -> Result<NaiveTime, String> {
+    let normalized = match input.matches(':').count() {
+        0 => format!("{input}:00:00"),
+        1 => format!("{input}:00"),
+        2 => input.to_owned(),
+        _ => return Err("invalid time; expected HH[:MM[:SS]]".to_owned()),
+    };
+    NaiveTime::parse_from_str(&normalized, "%H:%M:%S").map_err(|error| error.to_string())
+}
