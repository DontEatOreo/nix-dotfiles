+fn commit_matches_redate(
+    commit: &Commit,
+    source: &Commit,
+    parent_ids: &[CommitId],
+    timestamp: Timestamp,
+    committer: &jj_lib::backend::Signature,
+) -> bool {
+    let commit_data = commit.store_commit();
+    let source_data = source.store_commit();
+    commit_data.parents == parent_ids
+        && commit_data.root_tree == source_data.root_tree
+        && commit_data.conflict_labels == source_data.conflict_labels
+        && commit_data.change_id == source_data.change_id
+        && commit_data.description == source_data.description
+        && commit_data.author.name == source_data.author.name
+        && commit_data.author.email == source_data.author.email
+        && commit_data.author.timestamp == timestamp
+        && commit_data.committer.name == committer.name
+        && commit_data.committer.email == committer.email
+        && commit_data.committer.timestamp == timestamp
+        && commit.verification().is_ok_and(|verification| {
+            verification.is_some_and(|verification| verification.status != SigStatus::Bad)
+        })
+}
