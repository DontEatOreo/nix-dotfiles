+/// Interactively set timestamps and sign rewritten revisions
+#[derive(clap::Args, Clone, Debug)]
+pub(crate) struct RedateArgs {
+    /// The revisions to redate
+    #[arg(value_name = "REVSETS")]
+    #[arg(add = ArgValueCompleter::new(complete::revset_expression_mutable))]
+    revisions_pos: Vec<RevisionArg>,
+
+    #[arg(short = 'r', hide = true, value_name = "REVSETS")]
+    #[arg(add = ArgValueCompleter::new(complete::revset_expression_mutable))]
+    revisions_opt: Vec<RevisionArg>,
+}
+
+#[instrument(skip_all)]
+pub(crate) async fn cmd_redate(
+    ui: &mut Ui,
+    command: &CommandHelper,
+    args: &RedateArgs,
+) -> Result<(), CommandError> {
+    let mut workspace_command = command.workspace_helper(ui).await?;
+    if !workspace_command.repo().store().signer().can_sign() {
+        return Err(user_error("No signing backend configured").hinted(
+            "For configuring a signing backend, see \
+             https://docs.jj-vcs.dev/latest/config/#commit-signing",
+        ));
+    }
+    if !ui.can_prompt() {
+        return Err(user_error("Cannot prompt for a redate timestamp")
+            .hinted("Run from a terminal or set JJ_INTERACTIVE=1"));
+    }
+    let interactive = args.revisions_pos.is_empty()
+        && args.revisions_opt.is_empty()
+        && io::stdin().is_terminal()
+        && io::stdout().is_terminal();
+    let target_expression = if !args.revisions_pos.is_empty() || !args.revisions_opt.is_empty() {
+        workspace_command
+            .parse_union_revsets(ui, &[&*args.revisions_pos, &*args.revisions_opt].concat())?
+    } else if interactive {
+        let revset = workspace_command.settings().get_string("revsets.redate")?;
+        let revset = match workspace_command
+            .settings()
+            .get::<usize>("redate.limit")
+            .optional()?
+        {
+            Some(0) => return Err(user_error("redate.limit must be greater than zero")),
+            Some(limit) => format!("latest(({revset}), {limit})"),
+            None => revset,
+        };
+        workspace_command.parse_revset(ui, &RevisionArg::from(revset))?
+    } else {
+        workspace_command.parse_revset(ui, &RevisionArg::AT)?
+    }
+    .resolve()?;
+    workspace_command
+        .check_rewritable_expr(&target_expression)
+        .await?;
+    let commits: Vec<Commit> = target_expression
+        .evaluate(workspace_command.repo().as_ref())?
+        .stream()
+        .commits(workspace_command.repo().store())
+        .try_collect()
+        .await?;
+    if commits.is_empty() {
+        writeln!(ui.status(), "No revisions to redate.")?;
+        return Ok(());
+    }
+    let commit_ids: Vec<jj_lib::backend::CommitId> = if interactive {
+        let rows = render_rows(ui, &workspace_command, &commits)?;
+        let Some(indices) = select_revisions(rows)? else {
+            return Ok(());
+        };
+        indices
+            .into_iter()
+            .map(|index| commits[index].id().clone())
+            .collect()
+    } else {
+        commits.iter().map(|commit| commit.id().clone()).collect()
+    };
+    let timestamp = prompt_timestamp(ui)?;
+    let display_timestamp = timestamp.to_datetime().unwrap().to_rfc3339();
+    let revision_label = match commit_ids.as_slice() {
+        [_] => "1 revision".to_owned(),
+        revisions => format!("{} revisions", revisions.len()),
+    };
+    if !ui.prompt_yes_no(
+        &format!("Redate {revision_label} to {display_timestamp}?"),
+        Some(true),
+    )? {
+        return Ok(());
+    }
+    metaedit::edit_commits(
+        ui,
+        &mut workspace_command,
+        &metaedit::MetaeditArgs::default(),
+        CommitEditOptions::redate(timestamp),
+        commit_ids,
+    )
+    .await
+}
