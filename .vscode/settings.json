{
  "files.associations": {
    "Brewfile": "ruby",
    "Containerfile": "dockerfile",
    "Justfile": "just",

    // xembly.gomplate provides combined Go-template and host-language
    // grammars for these formats. Keep the generic mapping as the fallback.
    "*.tmpl": "gomplate",
    "*.bash.tmpl": "goshell",
    "*.css.tmpl": "gocss",
    "*.html.tmpl": "gohtml",
    "*.js.tmpl": "gojs",
    "*.json.tmpl": "gojson",
    "*.sh.tmpl": "goshell",
    "*.ts.tmpl": "gots",
    "*.yaml.tmpl": "goyaml",
    "*.yml.tmpl": "goyaml",
    "*.zsh.tmpl": "goshell",

    // For host formats that gomplate does not embed, retain the base language
    // mode so its native syntax, navigation, and completion remain available.
    "*.conf.tmpl": "properties",
    "*.desktop.tmpl": "properties",
    "*.fish.tmpl": "fish",
    "*.gitconfig.tmpl": "gitconfig",
    "*.glsl.tmpl": "glsl",
    "*.ghostty.tmpl": "properties",
    "*.hjson.tmpl": "hjson",
    "*.jsonc.tmpl": "jsonc",
    "*.lua.tmpl": "lua",
    "*.plist.tmpl": "xml",
    "*.py.tmpl": "python",
    "*.rb.tmpl": "ruby",
    "*.ron.tmpl": "ron",
    "*.scss.tmpl": "scss",
    "*.theme.tmpl": "properties",
    "*.tmTheme.tmpl": "xml",
    "*.toml.tmpl": "toml",
    "*.xml.tmpl": "xml",

    "*.m": "objective-c",
    "*.mm": "objective-cpp",
    "*.plist.in": "xml",
    "*.py.in": "python",
    "*.xml.in": "xml",

    "ansible/**/*.yml": "ansible",
    "ansible/**/*.yaml": "ansible",
    "**/*.plist.j2": "jinja-xml",
    "**/*.py.j2": "jinja-py",
    "**/*.sh.j2": "jinja-shell",

    // Chezmoi treats every file in .chezmoitemplates as a template, including
    // the three extensionless/non-.tmpl partials currently in this source tree.
    "**/.chezmoitemplates/executable_fingerprint": "gomplate",
    "**/.chezmoitemplates/theme_rgb": "gomplate",
    "**/.chezmoitemplates/vscode_settings.json": "gojson",

    "**/dot_bash_profile.tmpl": "goshell",
    "**/dot_bashenv.tmpl": "goshell",
    "**/dot_bashrc.tmpl": "goshell",
    "**/dot_gitconfig.tmpl": "gitconfig",
    "**/private_dot_ssh/private_config.tmpl": "ssh_config",
    "**/dot_zshenv.tmpl": "goshell",
    "**/dot_zshrc.tmpl": "goshell"
  },
  "explorer.excludeGitIgnore": true,
  "C_Cpp.default.cStandard": "c23",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/packages/terminal-theme-tools/include"
  ],
  // cpptools still misparses C23 constexpr declarations. Rely on clang-tidy
  // diagnostics until its C23 parser support catches up:
  // https://github.com/microsoft/vscode-cpptools/issues?q=is%3Aissue%20C23%20constexpr
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
  "C_Cpp.codeAnalysis.exclude": {
    "**/vendor/tomlc17/tomlc17.{c,h}": true
  },
  "C_Cpp.formatting": "clangFormat",
  "search.exclude": {
    "**/.ansible": true,
    "**/.cache": true,
    "**/.complexipy_cache": true,
    "**/.direnv": true,
    "**/.gradle": true,
    "**/.jj": true,
    "**/.pytest_cache": true,
    "**/.ruby-lsp": true,
    "**/.ruff_cache": true,
    "**/.rumdl_cache": true,
    "**/.swiftpm": true,
    "**/.venv": true,
    "**/.zig-cache": true,
    "**/__pycache__": true,
    "**/build": true,
    "**/build-*/**": true,
    "**/builddir/**": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/zig-out/**": true,
    "result": true,
    "secrets": true
  },
  "files.watcherExclude": {
    "**/.ansible/**": true,
    "**/.cache/**": true,
    "**/.complexipy_cache/**": true,
    "**/.direnv/**": true,
    "**/.gradle/**": true,
    "**/.jj/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruby-lsp/**": true,
    "**/.ruff_cache/**": true,
    "**/.rumdl_cache/**": true,
    "**/.swiftpm/**": true,
    "**/.venv/**": true,
    "**/.zig-cache/**": true,
    "**/__pycache__/**": true,
    "**/build/**": true,
    "**/build-*/**": true,
    "**/builddir/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/zig-out/**": true,
    "result/**": true,
    "secrets/**": true
  },
  "shellcheck.ignorePatterns": {
    "**/*.csh": true,
    "**/*.cshrc": true,
    "**/*.fish": true,
    "**/*.login": true,
    "**/*.logout": true,
    "**/*.tcsh": true,
    "**/*.tcshrc": true,
    "**/*.xonshrc": true,
    "**/*.xsh": true,
    "**/*.zsh": true,
    "**/*.zshrc": true,
    "**/zshrc": true,
    "**/*.zprofile": true,
    "**/zprofile": true,
    "**/*.zlogin": true,
    "**/zlogin": true,
    "**/*.zlogout": true,
    "**/zlogout": true,
    "**/*.zshenv": true,
    "**/zshenv": true,
    "**/*.zsh-theme": true,
    "**/*.bash.tmpl": true,
    "**/*.sh.tmpl": true,
    "**/*.zsh.tmpl": true,
    "**/dot_bashrc.tmpl": true,
    "**/dot_zshrc.tmpl": true
  },
  "shellcheck.customArgs": ["--source-path=SCRIPTDIR"],
  "shellcheck.useWorkspaceRootAsCwd": true,
  "shfmt.formatIgnored": false,
  "bashIde.shellcheckPath": "",
  "bashIde.shfmt.path": "shfmt",
  "git.mergeEditor": true,
  "git.branchProtection": ["main", "master"],
  "git.branchProtectionPrompt": "alwaysCommitToNewBranch",
  "git.branchRandomName.enable": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.tsdk.path": "dotfiles/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "python.languageServer": "None",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.useEnvironmentsExtension": true,
  "python-envs.workspaceSearchPaths": [".venv"],
  "ty.diagnosticMode": "workspace",
  "ty.importStrategy": "fromEnvironment",
  "ty.path": ["ty"],
  "ruff.importStrategy": "fromEnvironment",
  "ruff.path": ["ruff"],
  "ruff.nativeServer": "on",
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.formatterPath": "nixfmt",
  "rubyLsp.formatter": "rubocop",
  "zig.path": "zig",
  "zig.version": "0.16.0",
  "ansible.ansible.useFullyQualifiedCollectionNames": true,
  "ansible.lightspeed.enabled": false,
  "ansible.lightspeed.suggestions.enabled": false,
  "ansible.mcpServer.enabled": false,
  "ansible.validation.lint.enabled": true,
  "markdownlint.run": "onSave",
  "redhat.telemetry.enabled": false,
  "stylua.disableVersionCheck": true,
  "stylua.searchBinaryInPATH": true,
  "systemd.version": "latest",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[zig]": {
    "editor.defaultFormatter": "ziglang.vscode-zig",
    "editor.formatOnSave": true
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[objective-c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[objective-cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "[lua]": {
    "editor.defaultFormatter": "johnnymorganz.stylua",
    "editor.formatOnSave": true
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "editor.formatOnSave": true
  },
  "[kdl]": {
    "editor.defaultFormatter": "kdl-org.kdl",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true
  }
}
