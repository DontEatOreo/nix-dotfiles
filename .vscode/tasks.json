{
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "revealProblems": "onProblem",
    "panel": "dedicated",
    "clear": true,
    "showReuseMessage": false,
    "preserveTerminalName": true
  },
  "tasks": [
    {
      "label": "repo: check",
      "detail": "Run the full repository validation suite.",
      "type": "process",
      "command": "just",
      "args": ["check"],
      "inAgents": true,
      "icon": {
        "id": "beaker",
        "color": "terminal.ansiGreen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "repo: lint",
      "detail": "Run formatting checks, linters, and project validation.",
      "type": "process",
      "command": "just",
      "args": ["lint"],
      "inAgents": true,
      "icon": {
        "id": "checklist",
        "color": "terminal.ansiCyan"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: check format",
      "detail": "Check repository formatting without rewriting files.",
      "type": "process",
      "command": "just",
      "args": ["check-format"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: format",
      "detail": "Format files managed by this repo.",
      "type": "process",
      "command": "just",
      "args": ["fmt"],
      "icon": {
        "id": "wand",
        "color": "terminal.ansiMagenta"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "repo: doctor",
      "detail": "Check commands required by a selected repository workflow.",
      "type": "process",
      "command": "just",
      "args": ["doctor", "${input:doctorProfile}"],
      "icon": {
        "id": "heart-pulse",
        "color": "terminal.ansiBlue"
      },
      "problemMatcher": []
    },
    {
      "label": "repo: watch check",
      "detail": "Rerun the validation suite whenever tracked inputs change.",
      "type": "process",
      "command": "just",
      "args": ["watch", "check"],
      "isBackground": true,
      "promptOnClose": true,
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "group": "watch"
      }
    },
    {
      "label": "bun: check",
      "detail": "Run Biome and every Bun workspace type check.",
      "type": "process",
      "command": "bun",
      "args": ["run", "check"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "ruby: lint",
      "detail": "Run the repository RuboCop configuration.",
      "type": "process",
      "command": "bundle",
      "args": ["exec", "rubocop", "libexec"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "nix: flake check (no build)",
      "detail": "Evaluate all flake checks without building their derivations.",
      "type": "process",
      "command": "nix",
      "args": ["flake", "check", "--keep-going", "--no-build"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "nix: build package",
      "detail": "Build a selected package output for the current system.",
      "type": "process",
      "command": "nix",
      "args": ["build", ".#${input:nixPackage}"],
      "icon": {
        "id": "package",
        "color": "terminal.ansiBlue"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dotfiles: preview",
      "detail": "Preview pending chezmoi changes without refreshing externals.",
      "type": "process",
      "command": "just",
      "args": ["dotfiles-diff"],
      "icon": {
        "id": "diff"
      },
      "problemMatcher": []
    },
    {
      "label": "dotfiles: render current template",
      "detail": "Render the active standalone template with this repository's chezmoi data.",
      "type": "process",
      "command": "chezmoi",
      "args": [
        "--source",
        "${workspaceFolder}/dotfiles",
        "--working-tree",
        "${workspaceFolder}",
        "--refresh-externals=never",
        "execute-template",
        "--file",
        "${file}"
      ],
      "icon": {
        "id": "preview"
      },
      "problemMatcher": []
    },
    {
      "label": "spectrum: validate",
      "detail": "Validate the BlueBuild recipe and its pinned base image.",
      "type": "process",
      "command": "just",
      "args": ["spectrum-validate"],
      "inAgents": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "spectrum: build",
      "detail": "Build the local Spectrum image on a supported Linux host.",
      "type": "process",
      "command": "just",
      "args": ["spectrum-build"],
      "icon": {
        "id": "layers",
        "color": "terminal.ansiBlue"
      },
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "doctorProfile",
      "type": "pickString",
      "description": "Workflow dependencies to check",
      "default": "all",
      "options": [
        "all",
        "status",
        "reboot",
        "install",
        "build",
        "setup",
        "apply",
        "shell",
        "spectrum",
        "fmt",
        "lint",
        "ansible",
        "bun",
        "nix",
        "watch",
        "check"
      ]
    },
    {
      "id": "nixPackage",
      "type": "pickString",
      "description": "Flake package to build for the current system",
      "default": "default",
      "options": [
        "default",
        "bluebuild-v2",
        "bun2nix",
        "check-jsonschema",
        "dotfiles-python",
        "equicord-settings",
        "hyper-window-tiling-gnome",
        "hyper-window-tiling-kde",
        "kmscon",
        "theme-run",
        "uresourced"
      ]
    }
  ]
}
