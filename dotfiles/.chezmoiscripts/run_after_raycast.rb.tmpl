{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "pathname"

brew = "/opt/homebrew/bin/brew"
formula = "4evy/dotfiles/raycast"
manager = "/opt/homebrew/bin/raycast-manager"
repository = Pathname({{ joinPath .chezmoi.sourceDir ".." | quote }})
tap = Pathname("/opt/homebrew/Library/Taps/4evy/homebrew-dotfiles")
brew_environment = {
  "HOMEBREW_NO_AUTO_UPDATE" => "1",
  "HOMEBREW_NO_ASK" => "1",
}

unless File.executable?(brew)
  warn "raycast: warning: Homebrew not installed; skipping"
  exit 0
end

{
  repository/"Formula/raycast.rb" => tap/"Formula/raycast.rb",
  repository/"libexec/raycast-manager.rb" => tap/"libexec/raycast-manager.rb",
}.each do |source, destination|
  unless source.file?
    warn "raycast: error: missing local tap source #{source}"
    exit 1
  end

  destination.dirname.mkpath
  FileUtils.cp(source, destination)
end

formula_installed = system(
  brew_environment,
  brew,
  "list",
  "--versions",
  formula,
  out: File::NULL,
  err: File::NULL,
)
brew_action = formula_installed ? "reinstall" : "install"
unless system(
  brew_environment,
  brew,
  brew_action,
  formula,
)
  warn "raycast: error: could not #{brew_action} #{formula}"
  exit 1
end

unless File.executable?(manager)
  warn "raycast: error: formula did not install #{manager}"
  exit 1
end

exec manager, "refresh"
{{- end -}}
