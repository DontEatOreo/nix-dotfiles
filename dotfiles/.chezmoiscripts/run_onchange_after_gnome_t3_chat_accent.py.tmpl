{{- $repo := .chezmoi.workingTree -}}
#!/usr/bin/env python3.14
# command fingerprint: {{ template "executable_fingerprint" (joinPath .chezmoi.homeDir ".local/bin/gnome-t3-chat-accent") }}
# helper source hash: {{ output "cat" (joinPath $repo "packages/dotfiles-python/src/workstation/local/gnome.py") (joinPath $repo "packages/dotfiles-python/assets/desktop/t3_chat_palette.json") (joinPath $repo "packages/dotfiles-python/assets/desktop/gtk-3-accent.css.in") (joinPath $repo "packages/dotfiles-python/assets/desktop/gtk-4-accent.css.in") | sha256sum }}
from __future__ import annotations

import os
import shutil
import subprocess
from pathlib import Path

command = Path(os.environ["CHEZMOI_HOME_DIR"]) / ".local/bin/gnome-t3-chat-accent"
if not command.is_file():
    command = Path(shutil.which("gnome-t3-chat-accent") or command)
if command.is_file() and os.access(command, os.X_OK):
    subprocess.run((command,), check=True)

systemctl = shutil.which("systemctl")
if systemctl is not None:
    subprocess.run(
        (
            systemctl,
            "--user",
            "disable",
            "--now",
            "gnome-black-rose-doll-accent.service",
        ),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        (systemctl, "--user", "daemon-reload"),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        (
            systemctl,
            "--user",
            "enable",
            "--now",
            "gnome-t3-chat-accent.service",
        ),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
{{- end }}
