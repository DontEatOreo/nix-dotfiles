from __future__ import annotations

import subprocess

{{ include ".chezmoitemplates/python-commands.py" }}

preferred = Path(os.environ["CHEZMOI_HOME_DIR"]) / ".local/bin/gnome-t3-chat-accent"
if command := find_executable("gnome-t3-chat-accent", preferred):
    subprocess.run((command,), check=True)

systemctl = shutil.which("systemctl")
if systemctl is not None:
    subprocess.run(
        (
            systemctl,
            "--user",
            "disable",
            "--now",
            "gnome-black-rose-doll-accent.service",
        ),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        (systemctl, "--user", "daemon-reload"),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        (
            systemctl,
            "--user",
            "enable",
            "--now",
            "gnome-t3-chat-accent.service",
        ),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
