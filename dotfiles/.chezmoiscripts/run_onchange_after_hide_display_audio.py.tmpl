{{- $repo := .chezmoi.workingTree -}}
#!/usr/bin/env python3.14
# Source fingerprint: {{ output "git" "-C" $repo "hash-object" (joinPath $repo "packages/hide-display-audio/Package.swift") (joinPath $repo "packages/hide-display-audio/Sources/EDIDKit/EDID.swift") (joinPath $repo "packages/hide-display-audio/Sources/HideDisplayAudio/main.swift") (joinPath $repo "packages/hide-display-audio/Sources/PrivateIOKit/PrivateIOKit.c") (joinPath $repo "packages/hide-display-audio/Sources/PrivateIOKit/include/PrivateIOKit.h") | sha256sum }}
from __future__ import annotations

import os
import shutil
import subprocess
from pathlib import Path

home = Path(os.environ["CHEZMOI_HOME_DIR"])
package = Path(os.environ["CHEZMOI_WORKING_TREE"]) / "packages/hide-display-audio"
swift = shutil.which("swift")
if swift is None:
    raise SystemExit("hide-display-audio build failed: swift is not available")

build = (
    swift,
    "build",
    "--package-path",
    str(package),
    "-c",
    "release",
)
subprocess.run(
    (*build, "-Xswiftc", "-warnings-as-errors", "-Xcc", "-Werror"), check=True
)
bin_path = subprocess.run(
    (*build, "--show-bin-path"),
    check=True,
    capture_output=True,
    text=True,
).stdout.strip()

destination = home / ".local/libexec/hide-display-audio"
destination.parent.mkdir(parents=True, exist_ok=True)
subprocess.run(
    ("/usr/bin/install", "-m", "0755", str(Path(bin_path) / destination.name), str(destination)),
    check=True,
)

domain = f"gui/{os.getuid()}"
label = "dev.4evy.hide-display-audio"
plist = home / "Library/LaunchAgents" / f"{label}.plist"
subprocess.run(
    ("/bin/launchctl", "bootout", domain, str(plist)),
    check=False,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)
subprocess.run(("/bin/launchctl", "bootstrap", domain, str(plist)), check=True)
{{ end -}}
