#!/usr/bin/env python3.14
"""Build a light/dark Black Rose Doll theme from Catppuccin's icon shapes."""
# Catppuccin source={{- if lookPath `code` -}}{{- $source := output `code` `--locate-extension` `catppuccin.catppuccin-vsc-icons` | trim -}}{{ $source }}{{ if $source }}@{{ (stat (joinPath $source `dist/mocha/theme.json`)).modTime }}{{ end }}{{- end }}

import json
import re
import shutil
import subprocess
from functools import partial
from pathlib import Path
from tempfile import TemporaryDirectory

UPSTREAM_ID = "catppuccin.catppuccin-vsc-icons"
CUSTOM_ID = "black-rose-doll-catppuccin-icons"
CUSTOM_EXTENSION = "evy.black-rose-doll-catppuccin-icons-1.0.0"
LIGHT_PREFIX = "__black_rose_doll_light__"
PALETTE_VARIABLE = re.compile(r"var\(--vscode-ctp-([a-z0-9-]+)\)")

BLACK_ROSE_DOLL = json.loads(
    r"""{{ .black_rose_doll | toJson }}"""
)

type Association = str | dict[str, str]


def prefix_references(value: Association) -> Association:
    return (
        f"{LIGHT_PREFIX}{value}"
        if isinstance(value, str)
        else {key: f"{LIGHT_PREFIX}{item}" for key, item in value.items()}
    )


def build_theme(upstream: Path) -> dict[str, object]:
    theme = json.loads((upstream / "dist/mocha/theme.json").read_text())
    definitions = theme.pop("iconDefinitions")
    theme["light"] = {
        key: prefix_references(value)
        for key, value in theme.items()
        if key != "hidesExplorerArrows"
    }
    theme["iconDefinitions"] = {
        f"{prefix}{name}": definition
        | {
            "iconPath": definition["iconPath"].replace(
                "./icons/", f"./icons/{variant}/", 1
            )
        }
        for variant, prefix in (("dark", ""), ("light", LIGHT_PREFIX))
        for name, definition in definitions.items()
    }
    return theme


def copy_icon(source: str, destination: str, *, palette: dict[str, str]) -> Path:
    source_path, destination_path = map(Path, (source, destination))
    svg = source_path.read_text(encoding="utf-8")
    destination_path.write_text(
        PALETTE_VARIABLE.sub(lambda match: palette[match[1]], svg), encoding="utf-8"
    )
    return destination_path


def write_json(path: Path, value: object) -> None:
    path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")


def main() -> None:
    code = shutil.which("code")
    if code is None:
        return
    located = subprocess.check_output(
        (code, "--locate-extension", UPSTREAM_ID), text=True
    ).strip()
    if not located:
        return

    upstream = Path(located)
    destination = upstream.parent / CUSTOM_EXTENSION
    with TemporaryDirectory(
        prefix=f".{CUSTOM_EXTENSION}-",
        dir=upstream.parent,
    ) as temporary_name:
        temporary = Path(temporary_name)
        write_json(
            temporary / "package.json",
            {
                "name": "black-rose-doll-catppuccin-icons",
                "displayName": "Black Rose Doll — Catppuccin Icons",
                "version": "1.0.0",
                "publisher": "evy",
                "engines": {"vscode": "^1.83.0"},
                "contributes": {
                    "iconThemes": [
                        {
                            "id": CUSTOM_ID,
                            "label": "Black Rose Doll — Catppuccin Icons",
                            "path": "./theme.json",
                        }
                    ]
                },
            },
        )
        write_json(temporary / "theme.json", build_theme(upstream))

        unflavored = upstream / "dist/unflavored"
        for variant in ("dark", "light"):
            shutil.copytree(
                unflavored,
                temporary / "icons" / variant,
                copy_function=partial(copy_icon, palette=BLACK_ROSE_DOLL[variant]),
            )

        if destination.exists():
            shutil.rmtree(destination)
        temporary.move(destination)


if __name__ == "__main__":
    main()
