#!/usr/bin/env python3.14
from __future__ import annotations

import os
import shutil
from pathlib import Path

home = Path(os.environ["CHEZMOI_HOME_DIR"])
brew = shutil.which("brew")
if brew is None:
    raise SystemExit

compat_source = Path(brew).parent.parent / "etc/bash_completion.d"
if not compat_source.is_dir():
    raise SystemExit

data = Path(os.environ.get("XDG_DATA_HOME", home / ".local/share"))
completion_base = data / "bash-completion"
completion_dir = completion_base / "completions"
empty_compat_dir = completion_base / "compat"
completion_dir.mkdir(parents=True, exist_ok=True)
empty_compat_dir.mkdir(parents=True, exist_ok=True)


def is_managed_link(path: Path) -> bool:
    if not path.is_symlink():
        return False
    link = path.readlink()
    if not link.is_absolute():
        link = path.parent / link
    return link.parent == compat_source


desired: dict[str, Path] = {}
for source in compat_source.iterdir():
    if source.name == "git-prompt.sh" or not source.is_file():
        continue
    name = "git" if source.name == "git-completion.bash" else source.name
    desired[name] = source

for target in completion_dir.iterdir():
    if is_managed_link(target) and target.name not in desired:
        target.unlink()

for name, source in desired.items():
    target = completion_dir / name
    if target.is_symlink():
        if not is_managed_link(target) or target.readlink() == source:
            continue
        target.unlink()
    elif target.exists():
        # Generated/user-authored completions take precedence over package
        # compatibility files with the same command name.
        continue
    target.symlink_to(source)
