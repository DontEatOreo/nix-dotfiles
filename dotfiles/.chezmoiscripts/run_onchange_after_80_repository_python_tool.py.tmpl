{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
{{- $repo := .chezmoi.workingTree -}}
#!/usr/bin/env python3.14
# project metadata hash: {{ output "cat" (joinPath $repo "pyproject.toml") (joinPath $repo "uv.lock") | sha256sum }}
# installer hash: {{ output "cat" (joinPath $repo "ansible/roles/bootstrap/tasks/python-tool.yml") | sha256sum }}
# command fingerprint: {{ template "executable_fingerprint" (joinPath .chezmoi.homeDir ".local/bin/terminal-t3-chat") }}
from __future__ import annotations

import os
import shutil
import subprocess
from pathlib import Path

repository = Path(os.environ["CHEZMOI_WORKING_TREE"])
ansible = shutil.which("ansible-playbook")
uvx = shutil.which("uvx")
if ansible is not None:
    command = (ansible,)
elif uvx is not None:
    command = (uvx, "--from", "ansible-core", "ansible-playbook")
else:
    print("Repository command refresh skipped: ansible-playbook/uvx not found")
    raise SystemExit(0)

subprocess.run(
    (*command, "ansible/site.yml", "--tags", "always,repo-tools"),
    cwd=repository,
    env=os.environ | {"ANSIBLE_BECOME_ASK_PASS": "false"},
    check=True,
)
{{ end -}}
