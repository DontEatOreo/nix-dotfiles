{{- if eq .chezmoi.os "darwin" -}}
{{- $repo := .chezmoi.workingTree -}}
#!/usr/bin/env python3.14
# Kanata source fingerprint: {{ include "dot_config/kanata/kanata-macos.kbd" | sha256sum }}:{{ output "shasum" "-a" "256" (joinPath $repo "ansible/library/dotfiles_codesign.py") (joinPath $repo "ansible/roles/system/tasks/macos.yml") (joinPath $repo "ansible/roles/system/templates/macos/kanata-app-info.plist.j2") (joinPath $repo "Formula/kanata-with-cmd.rb") | sha256sum }}
from __future__ import annotations

import os
import shutil
import subprocess
from pathlib import Path

repository = Path(os.environ["CHEZMOI_WORKING_TREE"])
ansible = shutil.which("ansible-playbook")
uvx = shutil.which("uvx")
if ansible is not None:
    command = (ansible,)
elif uvx is not None:
    command = (uvx, "--from", "ansible-core", "ansible-playbook")
else:
    raise SystemExit(
        "kanata reconciliation failed: ansible-playbook/uvx is not available"
    )

subprocess.run(
    (
        *command,
        "ansible/site.yml",
        "--tags",
        "always,kanata",
    ),
    cwd=repository,
    check=True,
)
{{- end }}
