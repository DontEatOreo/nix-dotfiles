{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/emblem.txt",
    "color": {
      "1": "#D60270",
      "2": "#9B4F96",
      "3": "#315FC3",
      "4": "#5BCEFA",
      "5": "#F5A9B8",
      "6": "#F7F7F7",
      "7": "#FCF434",
      "8": "#555555"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ›  ",
    "color": {
      "keys": "#F5A9B8",
      "title": "#D60270",
      "separator": "#9B4F96"
    },
    "key": {
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "color": {
        "elapsed": "#5BCEFA",
        "total": "#9B4F96"
      },
      "width": 10
    },
    "percent": {
      "type": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#38;2;214;2;112}{user-name}{#}@{#38;2;91;206;250}{host-name}{#}  {#38;2;252;244;52}✦{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;214;2;112}━━━━{#}{#38;2;155;79;150}━━━━{#}{#38;2;49;95;195}━━━━{#}{#38;2;91;206;250}━━━━{#}{#38;2;245;169;184}━━━━{#}{#38;2;252;244;52}━━━━{#}"
    },
    {
      "type": "os",
      {{- if eq .chezmoi.os "darwin" }}
      "key": "  macOS   ",
      {{- else }}
      "key": "󰣛  os      ",
      {{- end }}
      "keyColor": "#D60270",
      "format": "{name}{?version-id} {version-id}{?}{?variant} · {variant}{?}"
    },
    {
      "type": "host",
      "key": "󰌢  host    ",
      "keyColor": "#9B4F96",
      "format": "{vendor} {family}"
    },
    {
      "type": "kernel",
      "key": "  kernel  ",
      "keyColor": "#315FC3",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "󰅐  uptime  ",
      "keyColor": "#5BCEFA",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "packages",
      "key": "󰏖  packages",
      "keyColor": "#F5A9B8",
      "format": "{all}{?rpm} · rpm {rpm}{?}{?brew-all} · brew {brew-all}{?}{?nix-all} · nix {nix-all}{?}{?flatpak-all} · flatpak {flatpak-all}{?}"
    },
    {{- if eq .chezmoi.os "darwin" }}
    {
      "type": "shell",
      "key": "  shell   ",
      "keyColor": "#F7F7F7",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {{- else }}
    {
      "type": "de",
      "key": "  desktop ",
      "keyColor": "#F7F7F7",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {{- end }}
    {
      "type": "terminal",
      "key": "  terminal",
      "keyColor": "#FCF434",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {
      "type": "cpu",
      "key": "󰍛  cpu     ",
      "keyColor": "#9B4F96",
      "format": "{name} · {cores-logical} threads"
    },
    {
      "type": "gpu",
      "key": "󰢮  gpu     ",
      "keyColor": "#5BCEFA",
      "format": "{name}{?type} [{type}]{?}"
    },
    {
      "type": "memory",
      "key": "󰘚  memory  ",
      "keyColor": "#F5A9B8",
      "format": "{percentage-bar}  {used} / {total}"
    },
    {
      "type": "disk",
      "key": "󰋊  disk    ",
      "keyColor": "#315FC3",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage}) · {filesystem}"
    },
    {
      "type": "battery",
      "key": "󰁹  battery ",
      "keyColor": "#FCF434",
      "format": "{capacity-bar}  {capacity} [{status}]"
    },
    "break"
  ]
}
