# 05 / Oh My Bash
# Load the framework before shared aliases and functions.
export OSH="$HOME/.oh-my-bash"
# shellcheck disable=SC2034
OSH_THEME=""
# Chezmoi refreshes the external archive; never put update checks on the shell
# startup path.
# shellcheck disable=SC2034
DISABLE_AUTO_UPDATE="true"

# Keep the plugin list explicit. Zoxide already provides directory jumping;
# bashmarks also steals the Git plugin's `g` alias when it loads afterward.
# shellcheck disable=SC2034
plugins=(git)

# Generated and package-provided completions live in bash-completion's standard
# lazy-load directory. Point its eager compatibility scan at the deliberately
# empty managed directory; the sync script indexes package files lazily.
_dotfiles_bash_completion_base="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion"
# shellcheck disable=SC2034
BASH_COMPLETION_COMPAT_DIR="$_dotfiles_bash_completion_base/compat"
unset _dotfiles_bash_completion_base

# Load Homebrew's supported Bash completion framework before Oh My Bash adds
# its Git and SSH definitions. Do not reload it if a system profile already did
# so (as on NixOS).
if [[ -z "${BASH_COMPLETION_VERSINFO[*]-}" &&
	-n "${HOMEBREW_PREFIX:-}" &&
	-r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]]; then
	# shellcheck source=/dev/null
	source "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
fi

# shellcheck disable=SC2034
completions=(git ssh)

# Shared commands come later, after framework setup.
# shellcheck disable=SC2034
aliases=()

if [[ -r "$OSH/oh-my-bash.sh" ]]; then
	# shellcheck source=/dev/null
	source "$OSH/oh-my-bash.sh"
fi
