#!/bin/sh
set -eu

# SOPS calls this command once for each age recipient it cannot otherwise
# satisfy. Return nothing for unrelated recipients so other key sources and
# key groups can continue to work normally.
recipient='age1kc4gmk6jztv6schw3mhwwea7nn8emce4uwqufawfwapv9tlgdazqz7fc2w'
if [ -n "${SOPS_AGE_RECIPIENT:-}" ] &&
	[ "$SOPS_AGE_RECIPIENT" != "$recipient" ]; then
	exit 0
fi

if ! command -v op >/dev/null 2>&1; then
	printf '%s\n' 'sops-age-key-1password: 1Password CLI is not installed' >&2
	exit 127
fi

identity=''
attempt=1
while [ "${attempt}" -le 3 ]; do
	if identity="$(op read 'op://Personal/SOPS-age-identity/password')"; then
		printf '%s\n' "${identity}"
		exit 0
	fi

	if [ "${attempt}" -lt 3 ]; then
		sleep 2
	fi
	attempt=$((attempt + 1))
done

exit 1
