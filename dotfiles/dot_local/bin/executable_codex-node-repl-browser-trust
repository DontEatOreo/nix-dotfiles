#!/bin/sh
set -eu

node_repl=/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node_repl
bundled_browser_service=/Applications/ChatGPT.app/Contents/Resources/plugins/openai-bundled/plugins/browser/scripts/browser-service.mjs
codex_home_dir=${CODEX_HOME:-"${HOME}/.codex"}
trusted_services=${NODE_REPL_TRUSTED_SERVICES:-}

browser_service=$(
	printf '%s\n' "$trusted_services" |
		sed -n 's/.*"browser"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
)

case "$browser_service" in
	"$bundled_browser_service" | \
		"$codex_home_dir"/plugins/cache/openai-bundled/browser/*/scripts/browser-service.mjs)
		browser_scripts_root=${browser_service%/browser-service.mjs}
		module_roots=${NODE_REPL_NODE_MODULE_DIRS:-}
		NODE_REPL_NODE_MODULE_DIRS=$browser_scripts_root
		NODE_REPL_TRUSTED_CODE_PATHS=$browser_scripts_root
		if [ -n "$module_roots" ]; then
			NODE_REPL_NODE_MODULE_DIRS=$NODE_REPL_NODE_MODULE_DIRS:$module_roots
			NODE_REPL_TRUSTED_CODE_PATHS=$NODE_REPL_TRUSTED_CODE_PATHS:$module_roots
		fi
		export NODE_REPL_NODE_MODULE_DIRS
		export NODE_REPL_TRUSTED_CODE_PATHS
		;;
esac

exec "$node_repl" "$@"
