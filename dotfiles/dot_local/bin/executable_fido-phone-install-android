#!/bin/bash
# shellcheck shell=bash
#
# Build, install, and configure the private FIDO Phone Android receiver.

set -o errexit
set -o nounset
set -o pipefail

readonly APPLICATION_NAME='fido-phone-install-android'
readonly APPLICATION_ID='dev.evy.fidophone'
readonly DEFAULT_ANDROID_HOME='/opt/homebrew/share/android-commandlinetools'
readonly DEFAULT_PHONE_DEVICE='samsung-s25'
readonly DEFAULT_PROJECT_DIRECTORY="${HOME}/.local/share/fido-phone/android"
readonly PROJECT_OVERRIDE="${FIDO_PHONE_ANDROID_PROJECT:-}"
readonly PROJECT_DIRECTORY="${PROJECT_OVERRIDE:-${DEFAULT_PROJECT_DIRECTORY}}"
readonly APK_OVERRIDE="${FIDO_PHONE_APK:-}"
readonly CONFIG_DIRECTORY="${XDG_CONFIG_HOME:-${HOME}/.config}/fido-phone"
readonly TOKEN_FILE="${FIDO_PHONE_TOKEN_FILE:-${CONFIG_DIRECTORY}/token}"

err() {
	echo "${APPLICATION_NAME}: $*" >&2
}

require_command() {
	local command_name="$1"

	if ! command -v "${command_name}" >/dev/null 2>&1; then
		err "required command is unavailable: ${command_name}"
		return 1
	fi
}

ensure_token() {
	local token_directory

	token_directory="$(dirname -- "${TOKEN_FILE}")"
	mkdir -p -- "${token_directory}"
	if [[ ! -f "${TOKEN_FILE}" ]]; then
		umask 077
		openssl rand -base64 32 >"${TOKEN_FILE}"
	fi
	chmod 600 "${TOKEN_FILE}"
}

read_token() {
	local token

	token="$(tr -d '\r\n' <"${TOKEN_FILE}")"
	if [[ ! "${token}" =~ ^[A-Za-z0-9+/]{43}=$ ]]; then
		err "invalid 256-bit base64 token: ${TOKEN_FILE}"
		return 1
	fi
	echo "${token}"
}

resolve_adb_serial() {
	local phone_address
	local phone_device
	local tailscale_command

	if [[ -n "${FIDO_PHONE_ADB_SERIAL:-}" ]]; then
		echo "${FIDO_PHONE_ADB_SERIAL}"
		return
	fi

	tailscale_command="$(command -v tailscale)"
	phone_device="${FIDO_PHONE_DEVICE:-${DEFAULT_PHONE_DEVICE}}"
	phone_address="$(
		"${tailscale_command}" status 2>/dev/null |
			awk -v device="${phone_device}" '$2 == device { print $1; exit }'
	)"
	if [[ -z "${phone_address}" ]]; then
		err "Tailscale device not found: ${phone_device}"
		return 1
	fi
	echo "${phone_address}:5555"
}

build_apk() {
	local android_home="$1"

	ANDROID_HOME="${android_home}" \
		gradle \
		--no-daemon \
		--console=plain \
		-p "${PROJECT_DIRECTORY}" \
		:app:assembleDebug
}

install_apk() {
	local adb_serial="$1"
	local apk_path="$2"
	local token="$3"
	local -a adb_device=(adb -s "${adb_serial}")

	adb connect "${adb_serial}"
	"${adb_device[@]}" install -r "${apk_path}"
	"${adb_device[@]}" shell run-as "${APPLICATION_ID}" mkdir -p files
	printf '%s\n' "${token}" |
		"${adb_device[@]}" shell run-as "${APPLICATION_ID}" tee files/fido-token \
			>/dev/null
	"${adb_device[@]}" shell run-as "${APPLICATION_ID}" chmod 600 files/fido-token
	"${adb_device[@]}" shell pm grant \
		"${APPLICATION_ID}" android.permission.POST_NOTIFICATIONS
	"${adb_device[@]}" shell cmd appops set \
		"${APPLICATION_ID}" SYSTEM_ALERT_WINDOW allow
	"${adb_device[@]}" shell dumpsys deviceidle whitelist \
		"+${APPLICATION_ID}"
	"${adb_device[@]}" shell am start -W \
		-n "${APPLICATION_ID}/.MainActivity"
}

main() {
	local adb_serial
	local android_home
	local apk_path
	local token

	require_command adb
	require_command openssl
	require_command tailscale

	if [[ -n "${APK_OVERRIDE}" ]]; then
		apk_path="${APK_OVERRIDE}"
	else
		require_command gradle
		if [[ ! -d "${PROJECT_DIRECTORY}" ]]; then
			err "Android project is missing: ${PROJECT_DIRECTORY}"
			return 1
		fi

		android_home="${ANDROID_HOME:-${DEFAULT_ANDROID_HOME}}"
		if [[ ! -d "${android_home}/platforms/android-36" ]]; then
			err "Android SDK platform 36 is missing under: ${android_home}"
			return 1
		fi
		build_apk "${android_home}"
		apk_path="${PROJECT_DIRECTORY}/app/build/outputs/apk/debug/app-debug.apk"
	fi

	ensure_token
	token="$(read_token)"
	adb_serial="$(resolve_adb_serial)"

	if [[ ! -f "${apk_path}" ]]; then
		err "Android APK is missing: ${apk_path}"
		return 1
	fi
	install_apk "${adb_serial}" "${apk_path}" "${token}"
	echo 'FIDO Phone is installed and listening over Tailscale.'
}

main "$@"
